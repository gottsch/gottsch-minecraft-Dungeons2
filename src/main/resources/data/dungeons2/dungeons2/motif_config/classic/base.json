      // #73. The furniture the slot exists for, and deliberately modest: `min_count` 0, so a
      // plain room USUALLY has none and the ones that do read as a store rather than as scenery
      // sprayed everywhere.
      //
      // The barrel is `oriented: false` ON PURPOSE. A barrel's `facing` defaults to `up` -- a
      // barrel standing on its base, which is what a barrel in a store room looks like. Orienting
      // it would lay it on its side against the wall, which is a different (and much louder)
      // thing. See PropConfig.PropVariant.
      "props": {
        "min_count": 0,
        "max_count": 2,
        "placement": "against_wall",
        "variants": [
          {
            "block": "minecraft:barrel",
            "weight": 3,
            "oriented": false
