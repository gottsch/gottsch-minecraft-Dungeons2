      "spawners": {
        "min_count": 0,
        "max_count": 1
      },
      "chests": {
        "min_count": 0,
        "max_count": 1,
        "variants": [
          {
            "block": "minecraft:chest",
            "weight": 1
          }
        ]
      }
    },
    {
      "name": "grand_hall",
      "abstract": true,
      "wall": {
        "patterns": [
          {
            "type": "dungeons2:courses",
            "config": {
              "courses": [
                {
                  "block": "minecraft:polished_andesite",
                  "corner_block": "minecraft:andesite",
                  "anchor": "top"
                }
              ]
            }
          }
        ]
      },
      "pots": {
        "min_count": 1,
        "max_count": 2,
        "loot_table": "dungeons2:pots/classic",
        "variants": [
          {
            "entity": "dungeonblocks:pot",
            "weight": 2
          },
          {
            "entity": "dungeonblocks:squat_clay_pot",
            "weight": 1
          },
          {
            "entity": "dungeonblocks:stone_pot",
            "weight": 2
          },
          {
            "entity": "dungeonblocks:squat_stone_pot",
            "weight": 1
          }
        ]
      },
      // #73, AS AN OPTION LIST (#65) -- the first shipped slot to use one, and the right place for
      // it: the two treatments are alternatives, not a combination, and a grand hall should be able
      // to be either.
      //
      // `flanking_door` is braziers either side of a doorway, which is what makes a hall read as
      // APPROACHED rather than merely entered. `against_wall` is ordinary furniture. A hall wants
      // one or the other; both at once reads as a store room someone put candles in.
      //
      // The explicit `none` is not optional (see manual 3b): without it every grand hall would get
      // furniture, and the slot would become the band's look rather than a room type.
      //
      // `min_size` 9 on the braziers because this inherits down: in a small room the flanking cells
      // are most of the wall the player can see, and two braziers there is a shrine, not a hall.
      // Options the room's size gates out drop BEFORE the weights are totalled, so a small hall
      // simply rolls between the barrels and nothing.
      "props": [
        {
          "weight": 3,
          "min_count": 0,
          "max_count": 2,
          "placement": "against_wall",
          "variants": [
            { "block": "minecraft:barrel", "weight": 3, "oriented": false },
            { "block": "minecraft:cauldron", "weight": 1 }
          ]
        },
        {
          "weight": 2,
          "min_size": 9,
          "min_count": 1,
          "max_count": 2,
          "placement": "flanking_door",
          "variants": [
            { "block": "dungeonblocks:brazier_block", "weight": 1, "oriented": false }
          ]
        },
        { "weight": 3, "none": true }
      ],
      "spawners": {
        "min_count": 0,
        "max_count": 1
      },
      "chests": {
        "min_count": 0,
        "max_count": 1,
        "variants": [
          {
            "block": "minecraft:chest",
            "weight": 1
          }
        ]
      }
    },
