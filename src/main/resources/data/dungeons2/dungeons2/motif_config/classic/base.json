{
  // #129: the mood biome painted over every floor's pieces; strata.json overrides it per band.
  "biome": "dungeons2:stone_halls",
  // #129 step 2: prefabs with a mood of their own, painted over their box instead of the band's.
  "template_biomes": {
    "dungeons2:rooms/classic/11x11_sewer_1": "dungeons2:flooded_cistern",
    "dungeons2:rooms/classic/7x13_sewer_1": "dungeons2:flooded_cistern",
    "dungeons2:rooms/classic/mud/7x9_sewer_1": "dungeons2:flooded_cistern",
    "dungeons2:rooms/classic/mud/7x13_sewer_1": "dungeons2:flooded_cistern",
    "dungeons2:rooms/classic/deepslate/11x11_sewer_1": "dungeons2:flooded_cistern",
    // the water bridges: a channel the full length of the room
    "dungeons2:rooms/classic/11x21_bridge_2": "dungeons2:flooded_cistern",
    "dungeons2:rooms/classic/17x21_bridge_2": "dungeons2:flooded_cistern",
    // the lava bridges and the lava hallway: the whole floor is lava, so the band's mood is wrong
    "dungeons2:rooms/classic/11x21_bridge_3": "dungeons2:molten_halls",
    "dungeons2:rooms/classic/17x21_bridge_3": "dungeons2:molten_halls",
    "dungeons2:rooms/classic/deepslate/11x21_bridge_3": "dungeons2:molten_halls",
    "dungeons2:rooms/classic/deepslate/hallway/7x17_hallway_2": "dungeons2:molten_halls"
  },
  "palette": {
    "base": "minecraft:stone_bricks",
    "shaft": "dungeonblocks:stone_bricks_pillar_block",
    "footing": "dungeonblocks:stone_bricks_pillar_base_block",
    "stair": "minecraft:stone_brick_stairs",
    "corbel": "dungeonblocks:polished_andesite_corbel_block",
    "inlay": "minecraft:polished_andesite",
    "inlay_alt": "minecraft:andesite",
    "ornament": "minecraft:chiseled_stone_bricks",
    "plinth_left": "dungeonblocks:left_large_stone_brick",
    "plinth_right": "dungeonblocks:right_large_stone_brick",

    // Added 2026-09-16. These four were LITERAL block ids inside schemes.json patterns until a
    // deepslate floor showed what that costs: a literal is unreachable by a band's palette, so the
    // band repainted the wall behind them and the pilasters stayed stone -- full height, on every
    // wall that rolled `panels`.
    //
    // StratumWeatheringCoverageTest could not have caught it, and it is worth knowing why before
    // trusting that guard again: it reports blocks the MOTIF'S OWN WEATHERING LIST ages, and
    // classic_weathering has no fluted-block rule. It catches un-AGED leaks, not un-REPAINTED ones.
    // Those are different failures and only the first has a test.
    "pilaster": "dungeonblocks:stone_bricks_fluted_block",
    // The weathered/worn material, for a `gradient` edge and a `path`. Named for what it reads as
    // rather than for cobblestone, so a band can answer with whatever its own era crumbles into.
    "rubble": "minecraft:cobblestone",
    "rubble_stair": "minecraft:cobblestone_stairs",
    // The bracket a `joists` ceiling rests its beams on. Added 2026-09-17 for the same reason as
    // the four above: it was a literal in schemes.json, so a deepslate floor kept SPRUCE corbels
    // under its beams against a deepslate wall. The beam itself stays a literal spruce log -- a
    // timber beam on a stone bracket is the intended reading, and the mud band does the same.
    "joist_bracket": "dungeonblocks:spruce_corbel_block",
    // The door a `strip` partition leaves its gap as (#74). Distinct from the `door` SECTION, which
    // is the room's own doorway; this one is a material a wall pattern places.
    "door_block": "dungeonblocks:spruce_dungeon_door",
    // The HIGH-CONTRAST inlay, added 2026-09-23. `inlay`/`inlay_alt` are the same mid-grey as the
    // stone bricks around them, so a pattern drawn in them only shows up close. `accent` is the
    // block a pattern uses when it is meant to be seen across the room: a different VALUE, not
    // just a different texture. A band answers with whatever contrasts with ITS base.
    "accent": "minecraft:deepslate_bricks",
    // A second accent, so a band can offer two contrasting blocks: the deepslate band splits its
    // patterns between basalt and tuff. A role holds one block, so two looks need two roles. Up
    // here it is the same block as `accent`, and a stone room cannot tell them apart.
    "accent_alt": "minecraft:deepslate_bricks",
    // #104: the tomb a `tombs` slot places. A role rather than a literal for the pilasters' reason
    // above: the deepslate band answers with deepslate_sarcophagus, and a literal here would lay
    // stone tombs on a deepslate floor.
    "sarcophagus": "dungeonblocks:stone_sarcophagus",
    // The flat stone a FLOOR pattern sets into the paving: a border's corners, a cross, a
    // checkerboard's or diagonal's second block. Added 2026-10-30 (Mark): the chamber's floor
    // border used `footing` for its corners, and `footing` is the base of a column -- so a big
    // chamber had a pillar base set flat into each corner of its floor, reading as an upside-down
    // column. One role per purpose: `footing` stands under a shaft; this lies in a floor.
    "floor_accent": "minecraft:chiseled_stone_bricks",
    // The course a rising vault springs from: the ring in the ceiling plane at its lip, and a
    // double barrel's spine. Added 2026-10-30 (Mark), for `floor_accent`'s reason: every vault
    // used `inlay`, which is also every flush border and course trim, and the mud band's used
    // `footing`, a column's base. One role per purpose, so a band can give its vaults a springing
    // stone without repainting its trim or its columns. The same polished andesite as `inlay`.
    "springing_inlay": "minecraft:polished_andesite"
  },
  "wall": {
    "wall": "$base",
    "pattern": {
      "patterns": [
        {
          "type": "dungeons2:courses",
          "config": {
            "courses": [
              {
                "block": "$plinth_left",
                "alternate_block": "$plinth_right",
                "alternate": "strict"
              }
            ]
          }
        },
        {
          "type": "dungeons2:courses",
          "config": {
            "courses": [
              {
                "block": "$stair",
                "anchor": "top",
                "offset": 0,
                "projection": 1,
                "orient": "toward_wall",
                "properties": { "half": "top" },
                "min_height": 6
              }
            ]
          }
        }
      ]
    }
  },
  "ceiling": {
    "ceiling": "$base"
  },
  "door": {
    "door": "dungeonblocks:spruce_dungeon_door",
    "lintel": "minecraft:polished_andesite",
    "floor": "minecraft:polished_andesite",
    "probability": 0.5
  },
  "corridor": {
    "floor": "minecraft:cobblestone",
    "alternate_floor": "$base",
    "ceiling": "$base",
    "pattern": {
      "type": "dungeons2:speckle",
      "config": {
        "secondary_block": "dungeonblocks:square_stone_brick",
        "probability": 0.1
      }
    },
    "height": 7,
    "narrow_height": 6,
    "profile": "arched",
    "arch_block": "minecraft:stone_brick_stairs",
    // #108 stage 3: at most one trench trap per corridor, across a straight level run. Shared by
    // every style below (a style may author its own). The bands in strata.json carry their own.
    "traps": { "chance": 0.25, "options": [
      { "kind": "false_floor", "weight": 2, "length": 2, "depth": 4, "spike_block": "minecraft:pointed_dripstone", "spike_properties": { "vertical_direction": "up" }, "spike_probability": 0.4 },
      { "kind": "false_floor", "weight": 1, "length": 2, "depth": 4, "spike_block": "dungeonblocks:dark_iron_spikes", "spike_properties": { "facing": "up" }, "spike_probability": 0.6 },
      { "kind": "hazard", "weight": 1, "length": 2, "depth": 4, "spike_block": "minecraft:pointed_dripstone", "spike_properties": { "vertical_direction": "up" }, "spike_probability": 0.4, "rim_block": "$inlay" }
    ] },
    "styles": [
      {
        "name": "vaulted",
        "weight": 3, "height": 7, "narrow_height": 6,
        "profile": "arched",
        "arch_block": "minecraft:stone_brick_stairs",
        "descent": { "chance": 0.5, "min_depth": 2, "max_depth": 4, "run": 2, "landing": 1 },
        "courses": [
          {
            "block": "$plinth_left",
            "alternate_block": "$plinth_right",
            "alternate": "strict",
            "anchor": "bottom",
            "offset": 0
          },
          {
            "block": "minecraft:polished_andesite",
            "anchor": "top",
            "offset": 1
          }
        ]
      },
      {
        "name": "grand",
        "weight": 1, "height": 8, "narrow_height": 7,
        "profile": "arched",
        "arch_block": "minecraft:stone_brick_stairs",
        "descent": { "chance": 0.5, "min_depth": 2, "max_depth": 4, "run": 2, "landing": 1 },
        "courses": [
          {
            "block": "$plinth_left",
            "alternate_block": "$plinth_right",
            "alternate": "strict",
            "anchor": "bottom",
            "offset": 0
          },
          {
            "block": "minecraft:polished_andesite",
            "anchor": "top", "offset": 1
          }
