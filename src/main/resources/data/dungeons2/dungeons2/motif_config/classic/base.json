            "type": "dungeons2:border",
            "projection": 2,
            "config": {
              "block": "minecraft:stone_brick_stairs",
              "inset": 1,
              "orient": "outward",
              "properties": { "half": "top" }
            }
          },
          {
            "type": "dungeons2:border",
            "projection": 1,
            "config": { "block": "minecraft:stone_bricks", "inset": 1 }
          },
