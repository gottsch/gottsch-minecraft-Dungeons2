            "layout": "dungeons2:centre",
            "block": "minecraft:stone_bricks",
            "stair_block": "minecraft:stone_brick_stairs",
            "centre_block": "minecraft:chiseled_stone_bricks",
            // `size` is the DAIS's own side and stays on the entry; `inset` is pure
            // placement, so it belongs to the layout. See PlatformLayoutPattern.
            "size": 3,
            "config": {
              "inset": 1
            },
            "orient": "inward"
