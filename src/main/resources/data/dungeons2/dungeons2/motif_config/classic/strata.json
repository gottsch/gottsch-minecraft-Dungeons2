{
  "strataByFloorIndex": [
    {
      "minFloorIndex": 0,
      // #45 step 4: this is what selects dungeons2:classic_mud_weathering. The SAME name also
      // opts the depth into rooms/classic/mud/normal (step 3) -- nothing ships that pool, so the
      // resolver falls back to the motif's rooms, which is the ordinary case and is silent.
      "name": "mud",
      "wall": {
        "wall": "minecraft:mud_bricks"
      },
      "ceiling": {
        "ceiling": "minecraft:mud_bricks"
      },
      "floor": {
        "base": "minecraft:mud_bricks",
        "alternateBase": "minecraft:packed_mud"
      },
      "door": {
        "door": "dungeonblocks:spruce_dungeon_door",
        // STONE, not mud. A lintel is a keystone -- it carries the load over the opening -- so it
        // is where a builder reaches for the strongest material they have, however crude the wall
        // around it. Ornament does not stop at a poor floor either.
        //
        // square_stone_brick specifically because it reads as MONOLITHIC: one undivided block of
        // dressed stone, which is what a lintel actually is. (Gottsch, 2026-08-25.)
        //
        // WHY NOT polished_andesite, which is what classic's own door uses: the two motifs sit at
        // different points of the SAME material ladder. Each tier's ornament is the tier above its
        // walls -- polished andesite upgrades stone bricks, and stone upgrades mud bricks. Copying
        // classic's answer here would skip a rung. The mud room templates follow the same ladder,
        // building their crown molding, corbels and facades from the dungeonblocks stone_* family
        // rather than the polished_andesite one.
        //
        // NAMESPACE: dungeonblocks, not dungeons2 -- the block ships in DungeonBlocks. A dungeons2:
        // id here would fail ShippedBlockIdsTest (and, unguarded, become air -- backlog #13).
        //
        // Was minecraft:packed_mud until 2026-08-25: tan on tan made the opening vanish into the
        // wall entirely.
        "lintel": "dungeonblocks:square_stone_brick",
        "floor": "minecraft:packed_mud",
        "probability": 0.5
      },
      "corridor": {
        "floor": "minecraft:packed_mud",
        "alternateFloor": "minecraft:mud_bricks",
        "ceiling": "minecraft:mud_bricks",
        "height": 7,
        "narrowHeight": 6,
        "profile": "arched",
        "archBlock": "minecraft:mud_brick_stairs"
      }
    },
    {
      "minFloorIndex": 1
    }
  ]
}
