    {
      // dungeons2:decoration -- the NEIGHBOUR-aware pass. Everything above decides one
      // block at a time; this one decides from a block's surroundings, which is what
      // cobwebs (air with a wall beside it) and creeping growth need.
      //
      // Its probabilities are ABSOLUTE, not conditional -- one roll per candidate
      // position, unlike the rule/aging chains above.
      //
      // It only ever writes into a cell the piece itself places as AIR (bar underwater
      // growth, which replaces the piece's own water). Nothing here can touch terrain.
      "processor_type": "dungeons2:decoration",

      // Air with at least one horizontally adjacent solid block. Corners and wall faces
      // web up; the middle of a room stays clear.
      "cobwebs": {
        "probability": 0.02,
        "blocks": ["minecraft:cobweb"]
      },

      // The angle webs are a DIFFERENT behaviour, not more entries in the palette above.
      // They are modelled as a triangular sheet gathering into the angle where two
      // surfaces meet and tapering away from it, so they need a wall AND a floor or
      // ceiling -- one halfway up a bare wall has nothing to gather into and reads as a
      // sheet hanging in mid-air. Both surfaces must be full cubes for the same reason
      // wall growth needs one; the processor works out the facing from the neighbours,
      // and picks the junction with the block's `half` (top = ceiling, bottom = floor).
      //
      // Higher than the plain web's rate on purpose: this fires on far fewer cells --
      // only wall/floor and wall/ceiling junctions -- so 0.02 here would be nearly
      // invisible.
      "corner_cobwebs": {
        "probability": 0.06,
        "blocks": [
          "dungeonblocks:angle_cobweb_1",
          "dungeonblocks:angle_cobweb_2"
        ]
      },

      // Growth in the air beside a wall, attached to the wall's face. "probability" is
      // the chance with nothing already growing next to the spot; each of the 6
      // neighbours that IS growth adds "bonus", capped at "max", and the spot inherits
      // its neighbour's species. That's what makes it spread in patches rather than an
      // even speckle -- turn "bonus" up for bigger, blotchier patches. Blocks should be
      // multiface (glow-lichen-like) to take a face; anything else is placed as-is.
      "wall_growth": {
        "probability": 0.04,
        "bonus": 0.22,
        "max": 0.55,
        "blocks": [
          "minecraft:glow_lichen",
          "dungeonblocks:lichen",
          "dungeonblocks:mold"
        ]
      },

      // What counts as dirt for floor_growth/hanging_growth below. Classic dungeons are
      // not authored with dirt -- this catches the dirt the AGING processor above makes
      // out of decayed stairs, which is exactly where a tuft of growth belongs.
      "dirt": {
        "tags": ["minecraft:dirt"]
      },
      // On top of a dirt block, where the cell above it is air. All single-block plants that
      // survive in the dark: mushrooms need darkness, and grass/fern/moss only need light to
      // SPREAD, not to stay put, so none of these pop off in an unlit dungeon.
      // (No tall_grass or large_fern -- those are two blocks high and only the lower half
      // would be placed.)
      "floor_growth": {
        "probability": 0.35,
        "blocks": [
          "minecraft:brown_mushroom",
          "minecraft:red_mushroom",
          "minecraft:moss_carpet",
          "minecraft:grass",
          "minecraft:fern",
          "minecraft:dead_bush"
        ]
      },
      // Underneath a dirt block, where the cell below it is air.
      "hanging_growth": {
        "probability": 0.3,
        "blocks": ["minecraft:hanging_roots"]
      },

      // Architectural blocks that delete themselves once the wall behind them is gone --
      // a corbel or ledge left hanging in the air after what it was bracketed onto
      // crumbled away. Structural, so no probability: it either has a wall or it doesn't.
      //
      // A block with a "facing" property is held up from BEHIND and by nothing else: it
      // GIVES support to what sits on top of it, it doesn't TAKE support from there, nor
      // from below, nor from whatever happens to sit beside it. Only the neighbour at
      // facing.getOpposite() is consulted.
      //
      // Deliberately generous otherwise, since a false positive deletes authored
      // architecture: any non-air block behind counts (a ledge mounted on a stair or on
      // another ledge stays put), and so does a neighbour that simply isn't part of this
      // piece -- absent means "nothing placed here", not "nothing is here".
      //
      // It follows that this fires only where weathering actually produced air, so how
      // often you see it is really a property of the aging rules above.
      "unsupported": {
        "tags": [
          "dungeonblocks:corbels",
          "dungeonblocks:ledges"
        ]
      }

      // -----------------------------------------------------------------------------
      // Water growth is OFF for classic -- classic dungeons have no standing water.
      // Copy this into a motif that does. Water on a solid floor becomes seagrass; the
      // air on top of water gets lily pads:
      //
      //   "underwater_growth": { "probability": 0.15, "blocks": ["minecraft:seagrass"] },
      //   "floating_growth":   { "probability": 0.02, "blocks": ["minecraft:lily_pad"] }
      // -----------------------------------------------------------------------------
    },

    // =========================================================================================
    // dungeons2:spawner (Backlog #10, added 2026-08-14) -- swaps an authored
    // dungeons2:spawner_marker block for the invisible dungeons2:mob_set_spawner, which spawns
    // this set when a player comes within `proximity` blocks.
    //
    // IT MATCHES A BLOCK, NOT A `d2:spawner` DATA MARKER, and that is not a preference.
    // SinglePoolElement.getSettings installs BlockIgnoreProcessor.STRUCTURE_BLOCK BEFORE
    // appending this list, and that processor returns null for a structure block -- REMOVING it
    // rather than replacing it. A pool processor never sees one. The observed symptom was neither
    // a spawner nor a visible structure block but the terrain the dungeon was carved out of,
    // because the cell was never written at all. See JigsawStripsStructureBlocksTest.
    //
    // WHY IT LIVES IN THE WEATHERING LIST, despite not weathering anything: a pool element names
    // exactly ONE processor_list, and all four pools already name this one. Splitting it would
    // mean every pool JSON growing a second reference and every future motif remembering both.
    // The file is really "the classic motif's placement processors"; the name predates having
    // any that were not weathering.
    //
    // IT ONLY EVER FIRES ON AUTHORED TEMPLATES, since nothing procedural places the marker.
    // Procedural rooms would reach the same spawner through BlockEntityData instead, which
    // DungeonPiece.applyBlockEntity has supported since Phase 3 and which nothing emits yet.
    //
    // ONE MARKER = ONE SET. A block carries no free text, so the per-cell override the DATA
    // marker allowed is gone. A motif wanting a second set registers a second marker block and
    // adds a second entry here naming it via `marker_block`.
    // =========================================================================================
    {
      "processor_type": "dungeons2:spawner",
      // Required -- a spawner with no set is a block that does nothing, and defaulting it would
      // make that failure silent. Shipped set is the dungeon's own vermin (#40/#41).
      "mob_set": "dungeons2:classic_vermin",
      // Defaults to dungeons2:spawner_marker; stated explicitly because it is the authored half
      // of this contract and a template author has to know what to place.
      "marker_block": "dungeons2:spawner_marker",
      // 8 blocks: rooms run 5-13 across, so this fires as the player enters the room rather
      // than as they step onto the cell.
      "proximity": 8.0,
      "min_mobs": 1,
      "max_mobs": 3
    }
  ]
}
