// Weathering for the CLASSIC motif. Applied to BOTH the procedural rooms/corridors
// (via PieceProcessors) and the authored .nbt prefabs (via the pool JSONs'
// "processors" field), so they age identically.
//
// PROBABILITIES ARE CONDITIONAL, NOT ABSOLUTE -- in both processors below.
//
//   * Down a chain ("output_blocks"): a stage only rolls if the stage before it hit.
//   * Across chains: when one source block has several rules, they are alternatives
//     tried in order, and a later one only rolls if the earlier ones missed.
//
// THE FORK FORMULA. To make the k-th rule listed on one source block take share s_k
// of that block, author:
//
//     p_k = s_k / (1 - (s_1 + s_2 + ... + s_k-1))
//
// i.e. divide the share you want by the fraction still unclaimed. Only the FIRST
// rule's authored number equals its share; nothing shields it.
//
// So two alternative chains that should each fire 30% of the time are authored
// 0.3 and 0.43 (0.3 / 0.7), not 0.3 and 0.3. A third at 20% is then 0.5. An even
// 15/15 split is 0.15 and 0.1765 (0.15 / 0.85) -- measured on the mud band's floor
// pair, which lands at 11.25% each once each route's own stage 2 has thinned it.
//
// To read an existing file the other way: s_k = p_k * (1-p_1) * ... * (1-p_k-1).
//
// A FORK IS TWO RULES ON ONE SOURCE BLOCK, not two entries in one rule's
// "output_blocks" -- that is a CHAIN, where stage 2 only rolls if stage 1 hit and
// REPLACES what stage 1 produced rather than being an alternative to it.
//
// Some splits are arithmetically impossible: if the shares before rule k already
// claim most of the block, the required p_k exceeds 1. You cannot have 60% and 50%.
//
// Rules for DIFFERENT source blocks never interfere.
//
// See dungeons2-forge-1.20.1-ProcessorManual.md for the whole pipeline.
//
// Only processors vetted for a procedural piece belong here. That means either
// per-block and position-keyed (minecraft:rule, dungeons2:aging), or neighbour-aware
// AND marked NeighbourAwareProcessor so PieceProcessors runs it over the whole piece
// instead of one chunk's slice (dungeons2:decoration). Anything else --
// minecraft:capped, say -- decides differently in each chunk a piece spans.
// See PieceProcessors.
{
  "processors": [
    {
      // dungeons2:aging -- for SHAPED blocks (stairs, slabs, walls). Unlike a vanilla
      // rule, it carries the source block's properties (facing/half/shape/waterlogged)
      // onto the replacement, and supports multi-stage decay chains.
      // "agings" caps how many stages of a chain may apply.
      "processor_type": "dungeons2:aging",
      // 3, so the DEEP DECAY chains at the bottom of this list can reach their third stage.
      // The two-stage chains above them are unaffected -- a chain only ever applies as many
      // stages as it actually lists.
      "agings": 3,
      "rules": [
        // NOTE: left_/right_large_stone_brick are NOT here. They are plain full cubes with no
        // properties to carry, which is the only thing this processor does that minecraft:rule
        // cannot, so they live in the minecraft:rule processor below. See the block comment there.
        {
          "block": "dungeonblocks:left_large_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_left_large_brick",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "dungeonblocks:left_large_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:cobblestone_brick",
              "probability": 0.43
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.1
            }
          ]
        },
        {
          "block": "dungeonblocks:right_large_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_right_large_brick",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "dungeonblocks:right_large_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:cobblestone_brick",
              "probability": 0.43
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.1
            }
          ]
        },
        {
          "block": "dungeonblocks:square_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_square_brick",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "dungeonblocks:square_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:cobblestone_brick",
              "probability": 0.43
            },
            {
              "block": "dungeonblocks:mossy_cobblestone_brick",
              "probability": 0.1
            }
          ]
        },
        {
          "block": "dungeonblocks:square_stone_brick",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_square_stone_brick",
              "probability": 0.3
            },
            {
              "block": "minecraft:mossy_cobblestone",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "dungeonblocks:square_stone_brick",
          "output_blocks": [
            {
              "block": "minecraft:cobblestone",
              "probability": 0.43
            },
            {
              "block": "minecraft:mossy_cobblestone",
              "probability": 0.1
            }
          ]
        },
        {
          // LATENT -- nothing places brick_stairs. If authored: air 3.0%. That was barred
          // outright while a wall block could not reach air; since 2026-08-25 it is merely a
          // rate to judge, so this is authorable as it stands.
          "block": "minecraft:brick_stairs",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_brick_stairs",
              "probability": 0.3
            },
            {
              "block": "minecraft:air",
              "probability": 0.1
            }
          ]
        },
        {
          "block": "minecraft:stone_brick_stairs",
          "output_blocks": [
            {
              "block": "minecraft:mossy_stone_brick_stairs",
              "probability": 0.3
            },
            {
              "block": "minecraft:mossy_cobblestone_stairs",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "minecraft:stone_brick_stairs",
          "output_blocks": [
            {
              "block": "minecraft:cobblestone_stairs",
              "probability": 0.43
            },
            {
              "block": "minecraft:dirt",
              "probability": 0.05
            }
          ]
        },
        {
          "block": "minecraft:stone_brick_stairs",
          "output_blocks": [
            {
              "block": "minecraft:polished_andesite_stairs",
              "probability": 0.5
            },
            {
              "block": "minecraft:dirt",
              "probability": 0.05
            }
          ]
        },
        // ===================================================================================
        // RULES KEYED ON AN INTERMEDIATE BLOCK (backlog #26)
        //
        // The rules below read as a continuing chain -- stone_brick_stairs -> cobblestone_stairs
        // -> andesite_stairs -> rubble -- and they are NOT one. AgingProcessor looks its rules up
        // by the INPUT block once and never re-resolves what it just produced, so a rule keyed on
        // another rule's OUTPUT is only reachable if something PLACES that block directly.
        // Multi-stage decay works only WITHIN one rule's own output_blocks.
        //
        // So each of these is either LATENT (nothing places its input; the rule never fires) or
        // LIVE (a prefab places it, and the rule fires today). Every rule is marked with which,
        // and with the rates it produces or would produce.
        //
        // CHECK BOTH SOURCES BEFORE CALLING ONE OF THESE DEAD. Backlog #26 called all six latent
        // on 2026-08-04 by reading the motif JSON. Three of them are placed by hand-built .nbt
        // prefabs, which run this very processor list -- found 2026-08-11 by parsing the palettes.
        // A block placed only in an .nbt is invisible to a grep over the datapack.
        //
        // Nothing here is deleted, deliberately: a latent rule is a block that would silently stop
        // weathering the moment someone authored it, which is the same invisible failure as the
        // dormancy itself.
        //
        // BOTH BUDGETS THESE RULES WERE WRITTEN AGAINST ARE VOID as of 2026-08-25, so the
        // "over budget" notes below are kept only as a record of what the rates used to mean.
        // The falling-block budget went when the terminus became dungeonblocks:rubble, which
        // does not fall; the no-air-in-a-wall rule went when Mark accepted the hole (see the
        // deep-decay block above). What is left is ordinary rate judgement.
        // ===================================================================================
        {
          // LATENT -- nothing places cobblestone_stairs: not a scheme, not a prefab palette.
          // If authored: rubble 1.5%. That was over the old 1% ceiling budget when the terminus
          // fell; rubble does not, so the rate now needs no ceiling caveat.
          "block": "minecraft:cobblestone_stairs",
          "output_blocks": [
            {
              "block": "minecraft:andesite_stairs",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:rubble",
              "probability": 0.05
            }
          ]
        },
        {
          // LIVE, via prefabs -- 8 of them place polished_andesite_stairs, including
          // entrance_1, entrance_exit_1 and every stairs_2_* segment, and every pool attaches
          // this processor list. So this rule fires today: rubble 1.5%, in the entrance and the
          // staircases. It was ABOVE the old 1% ceiling budget while the terminus was falling
          // gravel -- a live over-budget rule, now moot. #26 recorded it as unreachable; that
          // was read off the motif JSON only and missed the .nbt palettes.
          "block": "minecraft:polished_andesite_stairs",
          "output_blocks": [
            {
              "block": "minecraft:andesite_stairs",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:rubble",
              "probability": 0.05
            }
          ]
        },
        {
          // LATENT. If authored: rubble 9.5% and air 0.5%. Both halves were over a budget once
          // and neither is now -- the rubble half only counted because gravel fell, and the air
          // half only because a wall block could not reach air at all. What is left is a rate to
          // judge: 9.5% is a lot of debris for one rule. Note the LIVE rules above produce
          // andesite_stairs but cannot reach this rule, which is why those rates are not already
          // in the dungeon.
          "block": "minecraft:andesite_stairs",
          "output_blocks": [
            {
              "block": "dungeonblocks:rubble",
              "probability": 0.1
            },
            {
              "block": "minecraft:air",
              "probability": 0.05
            }
          ]
        },

        {
          "block": "dungeonblocks:large_bricks",
          "output_blocks": [
            {
              "block": "dungeonblocks:mossy_large_bricks",
              "probability": 0.3
            },
            {
              "block": "dungeonblocks:mossy_bricks",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "dungeonblocks:large_bricks",
          "output_blocks": [
            {
              "block": "minecraft:bricks",
              "probability": 0.43
            },
            {
              "block": "dungeonblocks:mossy_bricks",
              "probability": 0.1
            }
          ]
        },

        {
          "block": "minecraft:stone_bricks",
          "output_blocks": [
            {
              "block": "minecraft:cracked_stone_bricks",
              "probability": 0.3
            },
            {
              "block": "minecraft:cobblestone",
              "probability": 0.3
            }
          ]
        },
        {
          "block": "minecraft:stone_bricks",
          "output_blocks": [
            {
              "block": "minecraft:mossy_stone_bricks",
              "probability": 0.43
            },
            {
              "block": "minecraft:mossy_cobblestone",
              "probability": 0.3
            }
          ]
        },
        {
          // LIVE, via prefabs -- 7 place stone_brick_slab (7x7_hall_1, the 7x7 junctions,
          // 9x9_junction_1, ladder1, stairs_1). Produces mossy 21% / cobblestone_slab 9%: no
          // air, no falling blocks, inside every budget. Nothing to do; recorded so it is not
          // mistaken for dead again.
          "block": "minecraft:stone_brick_slab",
          "output_blocks": [
            {
              "block": "minecraft:mossy_stone_brick_slab",
              "probability": 0.3
            },
            {
              "block": "minecraft:cobblestone_slab",
              "probability": 0.3
            }
          ]
        },
        {
          // LIVE, via prefabs -- stairs_1 places stone_brick_wall. Produces mossy 21% /
          // cobblestone_wall 9%: inside every budget, same as stone_brick_slab.
          "block": "minecraft:stone_brick_wall",
          "output_blocks": [
            {
              "block": "minecraft:mossy_stone_brick_wall",
              "probability": 0.3
            },
            {
              "block": "minecraft:cobblestone_wall",
              "probability": 0.3
            }
          ]
        },

        // ===================================================================================
        // DEEP DECAY -- the chains that take a plain wall/floor/ceiling block down to rubble:
        //
        //     <wall block> -> cobblestone -> dirt -> dungeonblocks:rubble
        //
        // This is the ONLY source of dirt in a classic dungeon, and floor_growth /
        // hanging_growth (below) have nothing to sprout from without it. Nothing authored in
        // motif_config/classic.json is ever dirt.
        //
        // THE LAST STAGE WAS minecraft:gravel UNTIL 2026-08-25, AND ITS POSITION WAS THE WHOLE
        // POINT. Gravel falls when the block under it is air -- harmless in a wall or a floor,
        // but from a CEILING it rains debris onto the player, and this chain is applied to the
        // wall, the floor and the ceiling alike because classic uses one block for all three
        // (#15) and a processor only ever sees the block, never the surface. Burying gravel two
        // stages deep made it ~9x rarer, which was the only lever available.
        //
        // dungeonblocks:rubble reads like gravel and does NOT fall, so that hazard is gone and
        // the chain position is no longer load-bearing. The rate was left where it was anyway:
        // the swap is deliberately incidence-neutral so the change is judgeable in game against
        // how classic looks today. If rubble should be commoner now that it is safe overhead,
        // raise the last stage -- that is a free decision this block bought, not a fix.
        //
        // AIR IS NO LONGER BARRED (Mark, 2026-08-25). It used to be, and the reasoning was
        // sound as far as it went: these chains apply to the wall, the floor AND the ceiling
        // alike (#15), so a hole that is welcome in a floor is the same rule as a hole in an
        // OUTER wall -- which breaches the shell, and any water in the terrain behind it then
        // flows in. Placing the room's air cannot prevent that, because the room is filled once
        // at generation and the water arrives afterwards, through the hole.
        //
        // THAT CONSEQUENCE IS ACCEPTED. If it leaves a hole, it leaves a hole. A ruined dungeon
        // that has been breached by the ground around it is the look; the occasional wet room is
        // the price, and it is a price rather than a bug. Do not "fix" a reported hole in a wall
        // by reinstating the ban -- check first whether the report is really about water volume,
        // which is a RATE question.
        //
        // So air is now an ordinary authoring choice here, bounded by taste rather than by rule.
        // NOTHING IN THESE CHAINS PRODUCES AIR TODAY -- lifting the ban did not add any, since
        // that is an incidence decision belonging with the rest of the weathering pass (#47).
        //
        // To scope either properly, give the surfaces DISTINCT BLOCKS in
        // motif_config/<motif>.json -- a ceiling block no wall uses can carry its own
        // rules, and so can a floor block. That is the only lever there is; the processor has
        // nothing else to discriminate on.
        //
        // MIND THE CONDITIONAL PROBABILITIES. Each block below already has two chains above,
        // at 0.3 and 0.43, so a third chain is only reached when BOTH of those missed:
        // 0.7 x 0.57 = 0.399 of the time. The 0.2 first stage is therefore worth
        // 0.2 x 0.399 = 8% absolute, and the stages after it compound from there:
        //
        //     cobblestone  5.6%      dirt  1.8%      rubble  0.6%
        //
        // To make the dungeon more ruinous, raise the FIRST stage (0.2). To trade dirt for
        // rubble, raise the last. AgingChainRatesTest asserts these composed rates, so update it
        // if you retune. It no longer asserts anything about air: see the note above.
        // ===================================================================================
        {
          "block": "minecraft:stone_bricks",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        // left_/right_large_stone_brick's deep decay is in the minecraft:rule processor too --
        // it has to be, or the two halves of their chain would live in different processors.
        {
          "block": "dungeonblocks:square_stone_brick",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:left_large_brick",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:right_large_brick",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:square_brick",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:large_bricks",
          "output_blocks": [
            { "block": "minecraft:cobblestone", "probability": 0.2 },
            { "block": "minecraft:dirt", "probability": 0.3 },
            { "block": "dungeonblocks:rubble", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:polished_andesite_crown_molding_block",
          "output_blocks": [
            { "block": "dungeonblocks:polished_andesite_crown_molding_block", "probability": 0.2 },
            { "block": "dungeonblocks:mossy_cobblestone_crown_molding_block", "probability": 0.3 },
            { "block": "minecraft:air", "probability": 0.25 }
          ]
        },
        {
          "block": "dungeonblocks:polished_andesite_facade_block",
          "output_blocks": [
            { "block": "dungeonblocks:polished_andesite_facade_block", "probability": 0.2 },
            { "block": "dungeonblocks:mossy_cobblestone_facade_block", "probability": 0.3 },
            { "block": "minecraft:air", "probability": 0.25 }
          ]
        },

        // ===================================================================================
        // TIMBER (Backlog #37, added 2026-08-13). Until now this file had 110 rules and not
        // one touched wood, so the joisted_hall's spruce hung factory-fresh in a room of
        // cracked, mossy, crumbling brick -- in the most visible position in the room.
        //
        // AIR IS SAFE HERE IN A WAY IT IS NOT ELSEWHERE, and that is still worth knowing even
        // though the deep-decay ban was lifted on 2026-08-25. Timber is the one material in this
        // dungeon that already has what #15 asks for: spruce_log and the spruce corbel are used
        // for beams and brackets and NOTHING else, and a beam hangs BELOW the ceiling slab
        // rather than being part of it, so a decayed beam leaves a gap in the run with the shell
        // intact. These rates were therefore never a compromise -- unlike a stone chain's air,
        // which is now allowed but does breach. Move spruce_log into a wall or ceiling and that
        // distinction is lost.
        //
        // ONE STAGE, AND STRIPPED IS NOT IT (revised 2026-08-14, after Mark walked it in game).
        // The original chain went spruce_log -> stripped -> air, which put ~30% of beams in a
        // stripped state. It does not read as age: stripped spruce is a clean, pale, evenly
        // planed block, so a stripped beam beside an untouched one reads as two DIFFERENT
        // materials chosen by an author rather than as one material that weathered. The gap
        // reads correctly, so the chain now goes straight to it.
        //
        // dungeonblocks ships NO aged timber -- 694 blocks, and the only wood variants are
        // stripped_* and the species families. So "stripped" and "gone" were the entire
        // vocabulary available, and dropping the first leaves exactly one stage. A genuinely
        // weathered log block is what it would take to have a middle state here at all.
        //
        // BOTH RULES MUST BE dungeons2:aging, not minecraft:rule. A log carries `axis` and
        // the corbel carries `facing`, and a vanilla rule drops properties: JoistSurface-
        // PatternProvider turns each log to lie ALONG its run, so a vanilla rule would silently
        // stand every weathered beam on end. That is moot while the only output is air, but it
        // stops being moot the moment anyone adds a real intermediate block back.
        //
        // COMPOSED RATES. Single stage now, so the rate IS the outcome -- no compounding, and
        // these chains are each block's only rule so no conditional discount applies either:
        //
        //     spruce_log     ->  15% gone   (85% untouched)
        //     spruce corbel  ->  10% gone   (90% untouched)
        //
        // The rates were RAISED from the old chain's 5.3% / 3.5% break-through, deliberately.
        // Those were second-stage figures sitting behind a 35% first stage that was carrying
        // the visible weathering; with stripped gone, holding them would have left timber ~95%
        // factory-fresh, which is the state #37 was raised to fix.
        //
        // The corbel stays below the beam for the original reason: a bracket is a single cell
        // and reads as missing, where a beam is a run and reads as broken. AgingChainRatesTest
        // asserts both, so retune there too.
        //
        // NOT AGED, deliberately:
        //   * minecraft:ladder -- the entrance shaft is built from it. A hole in a ladder is
        //     not decoration, it is a descent the player cannot make.
        //   * the dungeon doors (spruce/dark_oak) -- dungeonblocks ships no aged form of one,
        //     and "sometimes there is no door" is ALREADY a feature (the motif's door
        //     probability, ~1/3 of openings). Ageing them to air would double-count it.
        //   * the stripped variants, in EITHER role. They are no longer produced as a stage,
        //     and they must not become sources: stripped_spruce_log appears in 8 authored
        //     templates where the author chose it, so a rule keyed on it would age the
        //     author's own choice. (While it WAS a stage, that was safe for a reason worth
        //     keeping: the processor looks a rule up by the input block once and never
        //     re-resolves what it just produced, so producing a block never ages it.)
        // ===================================================================================
        {
          "block": "minecraft:spruce_log",
          "output_blocks": [
            { "block": "minecraft:air", "probability": 0.15 }
          ]
        },
        {
          "block": "dungeonblocks:spruce_corbel_block",
          "output_blocks": [
            { "block": "minecraft:air", "probability": 0.1 }
          ]
        }
      ]
    },
    {
      // minecraft:rule (vanilla) -- for plain FULL CUBES only. A vanilla rule emits a
      // fixed output_state and DROPS the input's properties, so never point one at a
      // stair/slab/wall: it would silently reset facing/half/shape. Use aging for those.
      "processor_type": "minecraft:rule",
      // ===================================================================================
      // left_/right_large_stone_brick live HERE, not in dungeons2:aging (moved 2026-08-05).
      //
      // WHY: aging exists to carry a block's PROPERTIES across a substitution -- facing, half,
      // shape, waterlogged -- which is what stairs, slabs and walls need. A large stone brick is
      // a plain full cube with nothing to carry, so it needs none of it.
      //
      // HOW THE SHAPE TRANSLATES. Both processors fall through on a probability MISS, and
      // neither re-reads what it just produced (VanillaRuleChainingTest proves both halves):
      //   * aging's several CHAINS on one block  ->  several rules here, in order.
      //   * aging's STAGES within one chain      ->  would need a SECOND minecraft:rule
      //                                             processor; a later rule in THIS one never
      //                                             sees an earlier rule's output.
      // Rather than add a second processor, the four outcomes are flattened into one ordered
      // run of rules. That is exactly equivalent: aging only ever places the DEEPEST stage a
      // block reached, so the intermediate states were never visible in the world anyway.
      //
      // THE NUMBERS ARE CONDITIONAL, like the ones below them. Each rule is only reached when
      // every rule above it missed, so the absolute rates are:
      //
      //     mossy 30%    cobblestone 9.8%    dirt 3.15%    rubble 1.05%    unchanged 56%
      //
      // which is what the aging chains composed to before the move -- the conversion is a
      // no-op in the world. AgingChainRatesTest#largeStoneBrickKeepsItsRatesAfterTheMoveToVanillaRules
      // recomputes this from the file, so retuning one number without the others fails the build.
      //
      // A NOTE ON OUTPUT BLOCKS: do not add a later rule keyed on minecraft:cobblestone hoping
      // to continue this chain. It would not catch the cobblestone produced here (first match
      // wins and returns), and it WOULD catch cobblestone that arrived as input -- the corridor
      // floor is minecraft:cobblestone. That cross-contamination is the one hazard aging does
      // not have, because its stages stay inside their own chain.
      // ===================================================================================
      "rules": [
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:left_large_stone_brick",
            "probability": 0.3
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:mossy_left_large_stone_brick" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:left_large_stone_brick",
            "probability": 0.14
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:cobblestone" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:right_large_stone_brick",
            "probability": 0.3
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:mossy_right_large_stone_brick" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:right_large_stone_brick",
            "probability": 0.14
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:cobblestone" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:left_large_mud_brick",
            "probability": 0.3
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:mossy_left_large_mud_brick" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:left_large_mud_brick",
            "probability": 0.14
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:packed_mud" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:right_large_mud_brick",
            "probability": 0.3
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:mossy_right_large_mud_brick" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "dungeonblocks:right_large_mud_brick",
            "probability": 0.14
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:packed_mud" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:stone_bricks",
            "probability": 0.1
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:mossy_stone_bricks" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:stone_bricks",
            "probability": 0.1111
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:cracked_stone_bricks" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:stone_bricks",
            "probability": 0.125
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:cobblestone" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:cobblestone",
            "probability": 0.15
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:mossy_cobblestone" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:cobblestone",
            "probability": 0.1765
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:rubble" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:polished_andesite",
            "probability": 0.3
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:andesite" }
        },
        {
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:chiseled_stone_bricks",
            "probability": 0.2
          },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "dungeonblocks:mossy_chiseled_stone_bricks" }
        }
      ]
    },
    {
      // dungeons2:decoration -- the NEIGHBOUR-aware pass. Everything above decides one
      // block at a time; this one decides from a block's surroundings, which is what
      // cobwebs (air with a wall beside it) and creeping growth need.
      //
      // Its probabilities are ABSOLUTE, not conditional -- one roll per candidate
      // position, unlike the rule/aging chains above.
      //
      // It only ever writes into a cell the piece itself places as AIR (bar underwater
      // growth, which replaces the piece's own water). Nothing here can touch terrain.
      "processor_type": "dungeons2:decoration",

      // Air with at least one horizontally adjacent solid block. Corners and wall faces
      // web up; the middle of a room stays clear.
      "cobwebs": {
        "probability": 0.02,
        "blocks": ["minecraft:cobweb"]
      },

      // The angle webs are a DIFFERENT behaviour, not more entries in the palette above.
      // They are modelled as a triangular sheet gathering into the angle where two
      // surfaces meet and tapering away from it, so they need a wall AND a floor or
      // ceiling -- one halfway up a bare wall has nothing to gather into and reads as a
      // sheet hanging in mid-air. Both surfaces must be full cubes for the same reason
      // wall growth needs one; the processor works out the facing from the neighbours,
      // and picks the junction with the block's `half` (top = ceiling, bottom = floor).
      //
      // Higher than the plain web's rate on purpose: this fires on far fewer cells --
      // only wall/floor and wall/ceiling junctions -- so 0.02 here would be nearly
      // invisible.
      "corner_cobwebs": {
        "probability": 0.06,
        "blocks": [
          "dungeonblocks:angle_cobweb_1",
          "dungeonblocks:angle_cobweb_2"
        ]
      },

      // Growth in the air beside a wall, attached to the wall's face. "probability" is
      // the chance with nothing already growing next to the spot; each of the 6
      // neighbours that IS growth adds "bonus", capped at "max", and the spot inherits
      // its neighbour's species. That's what makes it spread in patches rather than an
      // even speckle -- turn "bonus" up for bigger, blotchier patches. Blocks should be
      // multiface (glow-lichen-like) to take a face; anything else is placed as-is.
      "wall_growth": {
        "probability": 0.04,
        "bonus": 0.22,
        "max": 0.55,
        "blocks": [
          "minecraft:glow_lichen",
          "dungeonblocks:lichen",
          "dungeonblocks:mold"
        ]
      },

      // What counts as dirt for floor_growth/hanging_growth below. Classic dungeons are
      // not authored with dirt -- this catches the dirt the AGING processor above makes
      // out of decayed stairs, which is exactly where a tuft of growth belongs.
      "dirt": {
        "tags": ["minecraft:dirt"]
      },
      // On top of a dirt block, where the cell above it is air. All single-block plants that
      // survive in the dark: mushrooms need darkness, and grass/fern/moss only need light to
      // SPREAD, not to stay put, so none of these pop off in an unlit dungeon.
      // (No tall_grass or large_fern -- those are two blocks high and only the lower half
      // would be placed.)
      //
      // The two "entity" entries are MOBS grown as if they were plants. GMM's Shrieker and Violet
      // Fungus root themselves and never move, so a patch of decayed dirt is exactly where they
      // belong -- and dungeons2:decoration spawns them from its finalizeProcessing pass, which has
      // a real ServerLevelAccessor and the chunk box to dedupe against. No marker block involved.
      //
      // THE PALETTE IS WEIGHTED. An entry is either a bare id (weight 1) or {block, weight}, and
      // the draw is one roll over the total. Weights matter here more than anywhere else in this
      // file: unweighted, the two fungi were 2 of 8 entries -- a QUARTER of everything that grows,
      // which is ground-cover frequency for something that is actually a monster. At 1 each against
      // the mushrooms' 10 they are 2 of 62, about 3%.
      "floor_growth": {
        "probability": 0.35,
        "blocks": [
          { "block": "minecraft:brown_mushroom", "weight": 10 },
          { "block": "minecraft:red_mushroom", "weight": 10 },
          { "block": "minecraft:moss_carpet", "weight": 10 },
          { "block": "minecraft:grass", "weight": 10 },
          { "block": "minecraft:fern", "weight": 10 },
          { "block": "minecraft:dead_bush", "weight": 10 },
          { "entity": "dungeons2:shrieker", "weight": 1 },
          { "entity": "dungeons2:violet_fungus", "weight": 1 }
        ]
      },
      // Underneath a dirt block, where the cell below it is air.
      "hanging_growth": {
        "probability": 0.3,
        "blocks": ["minecraft:hanging_roots"]
      },

      // Architectural blocks that delete themselves once the wall behind them is gone --
      // a corbel or ledge left hanging in the air after what it was bracketed onto
      // crumbled away. Structural, so no probability: it either has a wall or it doesn't.
      //
      // A block with a "facing" property is held up from BEHIND and by nothing else: it
      // GIVES support to what sits on top of it, it doesn't TAKE support from there, nor
      // from below, nor from whatever happens to sit beside it. Only the neighbour at
      // facing.getOpposite() is consulted.
      //
      // Deliberately generous otherwise, since a false positive deletes authored
      // architecture: any non-air block behind counts (a ledge mounted on a stair or on
      // another ledge stays put), and so does a neighbour that simply isn't part of this
      // piece -- absent means "nothing placed here", not "nothing is here".
      //
      // It follows that this fires only where weathering actually produced air, so how
      // often you see it is really a property of the aging rules above.
      "unsupported": {
        "tags": [
          "dungeonblocks:corbels",
          "dungeonblocks:ledges"
        ]
      }

      // -----------------------------------------------------------------------------
      // Water growth is OFF for classic -- classic dungeons have no standing water.
      // Copy this into a motif that does. Water on a solid floor becomes seagrass; the
      // air on top of water gets lily pads:
      //
      //   "underwater_growth": { "probability": 0.15, "blocks": ["minecraft:seagrass"] },
      //   "floating_growth":   { "probability": 0.02, "blocks": ["minecraft:lily_pad"] }
      // -----------------------------------------------------------------------------
    },
    // =========================================================================================
    // dungeons2:pot (added 2026-08-29) -- backlog #56. Turns an authored dungeons2:pot_marker into
    // pot ENTITIES and leaves air where the marker stood.
    //
    // BEFORE the sweep, deliberately. This processor's finalizeProcessing rewrites each marker cell
    // to air; decoration_sweep's job is to remove decoration left unsupported by a cell that is now
    // empty, so it has to run after the cell empties or it sweeps against stale ground.
    //
    // No loot_table or variant here: those are pool-level fallbacks for markers that name none of
    // their own, and every marker is expected to. A marker that resolves to no variant logs
    // [D2-POT] and spawns nothing rather than guessing a pot.
    // =========================================================================================
    {
      "processor_type": "dungeons2:pot"
    },

    // =========================================================================================
    // dungeons2:chest (added 2026-08-30) -- backlog #61, wiring the #48 step 3 marker that had
    // been left reachable from nothing. Turns an authored dungeons2:chest_marker into a chest
    // holding a loot table, and is the authored twin of the `chests` scheme slot.
    //
    // WHY IT IS HERE AND NOT IN ITS OWN LIST. It shipped in dungeons2:classic_chests, which no
    // pool ever referenced -- that list existed for one throwaway test template (0bc6a45) that was
    // removed again (93baad8), leaving the processor orphaned. Every room, entrance and transition
    // pool names a weathering list, so a marker processor that is not IN one is a marker block
    // left standing in a finished dungeon. Same conclusion #56 reached for pots, same placement.
    //
    // BEFORE the sweep, for the same reason the pot entry is: nothing it does should be judged
    // against ground a later pass is still going to change.
    //
    // Unlike the pot entry this one DOES carry a pool-level default, because "an ordinary chest
    // with ordinary dungeon loot" is a meaningful thing to want and a pot's variant is not -- a
    // pot with no variant has no appearance to fall back on. A marker's own `lootTable` NBT still
    // wins over this; the list is what a template full of ordinary chests relies on.
    //
    // The weights are one blend for the whole motif, NOT a depth band. A StructureProcessor is
    // handed no floorIndex, so unlike the procedural route this cannot follow
    // chestLootByFloorIndex; a template that wants depth-correct loot names the table on the
    // marker. The blend leans shallow because most floors of most dungeons are.
    // =========================================================================================
    {
      "processor_type": "dungeons2:chest",
      "loot_tables": [
        { "loot_table": "dungeons2:chests/classic_shallow", "weight": 6 },
        { "loot_table": "dungeons2:chests/classic_deep", "weight": 3 },
        { "loot_table": "dungeons2:chests/classic_hoard", "weight": 1 }
      ]
    },

    // =========================================================================================
    // dungeons2:decoration_sweep (added 2026-08-26) -- undoes the decoration above in cells a
    // LATER piece is about to invalidate. It must come after dungeons2:decoration: it inspects
    // what that pass decided, and finalizeProcessing runs the list in order.
    //
    // THE DEFECT. Found at -38 1 1801: a dungeonblocks:mold with south=true clinging to a
    // polished_andesite_quarter_facade_block -- a quarter slab, so the quad hung 12/16 of a block
    // off its only support. wall_growth's isFullCube guard is what should have stopped that, and
    // it did: the piece north of that wall row grew the mold against ITS OWN full-cube wall block,
    // and the 5x11_hallway_2 prefab south of it -- authored, and therefore rendered last, per the
    // shared-wall rule in backlog #18 -- then re-skinned the same cell with the facade. The
    // processor validated inputs that were true when it ran and false by the time anyone saw them.
    //
    // WHY IT CANNOT BE FIXED INSIDE dungeons2:decoration. The piece that breaks the support is a
    // DIFFERENT piece running later; at growth time the facade does not exist yet, and a
    // piece-local processor is forbidden from reading the world anyway. Only the breaking piece is
    // in a position to notice, which is why this is a second entry rather than another rule.
    //
    // WHAT IT TOUCHES. Only cells this piece does NOT itself write (anything it writes is about to
    // be overwritten regardless), only blocks named below, and only when the support test that
    // placed them now fails. Anything it cannot see counts as supported -- a false positive
    // deletes somebody's architecture, a false negative is one mold quad that outstayed its
    // welcome.
    //
    // EVERY FIELD MIRRORS ONE dungeons2:decoration BEHAVIOUR and must name the same blocks it
    // does; a processor cannot see its siblings in the list, so the pairing is by convention and
    // pinned by DecorationSweepParityTest, which reads both entries out of this file.
    // (No underwater_growth/floating_growth counterparts, for the same reason there are none
    // above: classic dungeons have no standing water.)
    // =========================================================================================
    {
      "processor_type": "dungeons2:decoration_sweep",

      // wall_growth. Multiface, so this repairs FACE BY FACE: a patch wrapping a corner keeps the
      // faces whose walls survived and loses only the dead one. Air when nothing is left.
      "growth": {
        "blocks": [
          "minecraft:glow_lichen",
          "dungeonblocks:lichen",
          "dungeonblocks:mold"
        ]
      },

      // cobwebs -- needs one horizontally adjacent solid block. Mostly a no-op in practice: a
      // facade still passes isSolid, so only a neighbour turning to AIR strands a plain web.
      "webs": {
        "blocks": ["minecraft:cobweb"]
      },

      // corner_cobwebs -- the pickier pair. Needs a full-cube wall behind its facing AND the
      // full-cube floor or ceiling its `half` names, exactly as maybeCornerCobweb required.
      "corner_webs": {
        "blocks": [
          "dungeonblocks:angle_cobweb_1",
          "dungeonblocks:angle_cobweb_2"
        ]
      },

      // Must be the same match as dungeons2:decoration's `dirt` -- it is what floor_growth and
      // hanging_growth below are tested against.
      "dirt": {
        "tags": ["minecraft:dirt"]
      },

      // floor_growth, minus the two entity entries: a Shrieker or a Violet Fungus is a MOB, and a
      // block sweep neither sees nor removes one.
      "floor_growth": {
        "blocks": [
          "minecraft:brown_mushroom",
          "minecraft:red_mushroom",
          "minecraft:moss_carpet",
          "minecraft:grass",
          "minecraft:fern",
          "minecraft:dead_bush"
        ]
      },
      "hanging_growth": {
        "blocks": ["minecraft:hanging_roots"]
      },

      // The same corbels and ledges the `unsupported` rule clears, re-tested once the neighbouring
      // piece has had its say: a ledge keeps whatever is behind its facing, and goes when that
      // turns to air.
      "unsupported": {
        "tags": [
          "dungeonblocks:corbels",
          "dungeonblocks:ledges"
        ]
      }
    },

    // =========================================================================================
    // dungeons2:spawner (Backlog #10, added 2026-08-14) -- swaps an authored
    // dungeons2:spawner_marker block for the invisible dungeons2:mob_set_spawner, which spawns
    // this set when a player comes within `proximity` blocks.
    //
    // IT MATCHES A BLOCK, NOT A `d2:spawner` DATA MARKER, and that is not a preference.
    // SinglePoolElement.getSettings installs BlockIgnoreProcessor.STRUCTURE_BLOCK BEFORE
    // appending this list, and that processor returns null for a structure block -- REMOVING it
    // rather than replacing it. A pool processor never sees one. The observed symptom was neither
    // a spawner nor a visible structure block but the terrain the dungeon was carved out of,
    // because the cell was never written at all. See JigsawStripsStructureBlocksTest.
    //
    // WHY IT LIVES IN THE WEATHERING LIST, despite not weathering anything: a pool element names
    // exactly ONE processor_list, and all four pools already name this one. Splitting it would
    // mean every pool JSON growing a second reference and every future motif remembering both.
    // The file is really "the classic motif's placement processors"; the name predates having
    // any that were not weathering.
    //
    // IT ONLY EVER FIRES ON AUTHORED TEMPLATES, since nothing procedural places the marker.
    // A procedural room reaches the same spawner through the motif config's `spawners` scheme
    // slot instead (RoomSpawnerGenerator -> BlockEntityData -> DungeonPiece.applyBlockEntity).
    // The two build the same block-entity tag; SpawnerTagParityTest is what keeps them agreeing,
    // so a field renamed here must be renamed there.
    //
    // EVERY FIELD BELOW IS A DEFAULT AN INDIVIDUAL MARKER MAY OVERRIDE (2026-09-03). The marker
    // carries a block entity, so a template can state mobSetName / proximity / minMobs / maxMobs /
    // type on one cell with /data merge block and leave the rest of its markers on these values.
    // This entry used to say "one marker = one set, a block carries no free text" -- that was
    // wrong: a structure template stores block-entity NBT PER CELL and hands it to a processor as
    // current.nbt(), which is how dungeons2:chest had been reading a per-marker loot table all
    // along. A second marker block via `marker_block` still works and is still the right answer
    // when a whole MOTIF wants a different default.
    // =========================================================================================
    {
      "processor_type": "dungeons2:spawner",
      // Required -- a spawner with no set is a block that does nothing, and defaulting it would
      // make that failure silent. Shipped set is the dungeon's own vermin (#40/#41).
      "mob_set": "dungeons2:classic_vermin",
      // Defaults to dungeons2:spawner_marker; stated explicitly because it is the authored half
      // of this contract and a template author has to know what to place.
      "marker_block": "dungeons2:spawner_marker",
      // Required, with no default anywhere -- see SpawnerConfig for why. 12 blocks: rooms run
      // 5-13 across, so this fires as the player comes through the door rather than once they
      // are well inside.
      "proximity": 12.0,
      "min_mobs": 1,
      "max_mobs": 3
    }
  ]
}
